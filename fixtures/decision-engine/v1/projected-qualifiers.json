            "active_tracks": { "t3": { "num_nonces_per_bundle": 25 } },
            "min_num_bundles": 2,
            "network_qualifiers_by_track": { "t3": 50 }
          }
        ],
        "pool_qualifiers_by_challenge_by_track": {
          "c501": { "t1": 3, "t2": 1 },
          "c502": { "t3": 6 }
        },
        "algorithm_track_stats": {
          "a501": {
            "t1": { "qualifiers": 6, "active_bundles": 12 },
            "t2": { "qualifiers": 3, "active_bundles": 4 }
          }
        },
        "hyperparameter_sources_available": { "c501": ["t1", "t2"], "c502": ["t3"] },
        "confirmed_in_flight_benchmarks": [
          { "benchmark_id": "bmk_00101", "challenge_id": "c501", "algorithm_id": "a501", "track_id": "t1", "num_bundles": 10 },
          { "benchmark_id": "bmk_00102", "challenge_id": "c501", "algorithm_id": "a501", "track_id": "t2", "num_bundles": 4 }
        ],
        "supplied_randomness": { "challenge_tie_draw_ranks": {} }
