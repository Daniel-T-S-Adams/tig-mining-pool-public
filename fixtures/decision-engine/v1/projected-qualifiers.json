      "expected": {
        "qualifier_rate": {
          "a501": {
            "t1": { "fraction": "6/12", "decimal_approx": 0.5 },
            "t2": { "fraction": "3/4", "decimal_approx": 0.75 }
          }
        },
        "expected_q": { "bmk_00101": 5, "bmk_00102": 3 },
        "expected_addition": { "c501": 8, "c502": 0 },
        "projected_raw_factor": {
          "c501": { "fraction": "12/48", "decimal_approx": 0.25 },
          "c502": { "fraction": "6/50", "decimal_approx": 0.12 }
        },
        "raw_factor_for_contrast": {
          "c501": { "fraction": "4/40", "decimal_approx": 0.1 },
          "c502": { "fraction": "6/50", "decimal_approx": 0.12 }
        },
        "tie_candidates": null,
        "selected_challenge": "c502"
      }
    },
    {
